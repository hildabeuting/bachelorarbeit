\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Das dyadische Gitter $(2^j, k\,2^j)$ mit logarithmisch aufgetragener Skala $a$. Jeder Gitterpunkt vertritt die Zelle $[2^j,2^{j+1}]\times [k\,2^j,(k+1)\,2^j]$ rechts oberhalb von ihm; alle Zellen haben bezüglich $da\,db/a^2$ den Inhalt $\tfrac  12$. Nur die Skalenachse ist logarithmisch, weil Stauchen multiplikativ, Verschieben dagegen additiv wirkt.}}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:dyadisches-gitter}{{3.7}{17}{Das dyadische Gitter $(2^j, k\,2^j)$ mit logarithmisch aufgetragener Skala $a$. Jeder Gitterpunkt vertritt die Zelle $[2^j,2^{j+1}]\times [k\,2^j,(k+1)\,2^j]$ rechts oberhalb von ihm; alle Zellen haben bezüglich $da\,db/a^2$ den Inhalt $\tfrac 12$. Nur die Skalenachse ist logarithmisch, weil Stauchen multiplikativ, Verschieben dagegen additiv wirkt}{figure.caption.10}{}}
