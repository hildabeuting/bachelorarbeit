\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Das dyadische Gitter. Die Skala $a$ ist logarithmisch aufgetragen. Dabei zählt $j$ die Skala und $k$ die Position auf dieser Skala. Jeder Punkt $(2^j,k2^j)$ vertritt die Zelle $Z_{j,k}$ rechts oberhalb von ihm. Hervorgehoben sind $Z_{-1,0} = [\tfrac  12,1]\times [0,\tfrac  12]$ und $Z_{2,1} = [4,8]\times [4,8]$. Ihre gewöhnlichen Flächen sind $\tfrac  14$ und $16$. Ihr Gewicht ist nach \eqref  {eq:zellengewicht} in beiden Fällen $\tfrac  12$.}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:dyadisches-gitter}{{3.7}{13}{Das dyadische Gitter. Die Skala $a$ ist logarithmisch aufgetragen. Dabei zählt $j$ die Skala und $k$ die Position auf dieser Skala. Jeder Punkt $(2^j,k2^j)$ vertritt die Zelle $Z_{j,k}$ rechts oberhalb von ihm. Hervorgehoben sind $Z_{-1,0} = [\tfrac 12,1]\times [0,\tfrac 12]$ und $Z_{2,1} = [4,8]\times [4,8]$. Ihre gewöhnlichen Flächen sind $\tfrac 14$ und $16$. Ihr Gewicht ist nach \eqref {eq:zellengewicht} in beiden Fällen $\tfrac 12$}{figure.caption.10}{}}
